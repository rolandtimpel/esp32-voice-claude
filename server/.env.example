# Kopieren nach ".env" und ausfüllen. ".env" wird NICHT committed (siehe .gitignore).

# Dein persönlicher Anthropic API-Key - niemals hier im Repo committen!
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude-Modell, das der Begleiter nutzen soll
ANTHROPIC_MODEL=claude-sonnet-5

# LAN-IP des Rechners/Servers, auf dem dieser Docker-Container läuft.
# Muss vom ESP32-Board im selben WLAN erreichbar sein (NICHT 127.0.0.1/localhost).
# Beispiel: 192.168.1.50
LAN_IP=

# Optional: Ports anpassen, falls 8000/8003 schon belegt sind (docker-compose.yml
# dann ebenfalls anpassen)
WS_PORT=8000
HTTP_PORT=8003

# Optional: Edge-TTS-Stimme (deutsch). Andere Stimmen:
# https://github.com/rany2/edge-tts -> "edge-tts --list-voices"
TTS_VOICE=de-DE-KatjaNeural

# Optional: Spracherkennungssprache für FunASR (auto|zh|en|ja|ko|yue)
ASR_LANGUAGE=auto

# Optional: gegen welchen xiaozhi-esp32-server-Branch/Tag gebaut wird
XIAOZHI_SERVER_REF=main
